# Multi-site profiles live in ~/.signalbase/analytics-sites.json. Keep live
# Stripe keys in this ignored .env and reference only their variable names.
ADMIX_STRIPE_SECRET_KEY=
SECOND_SITE_STRIPE_SECRET_KEY=
