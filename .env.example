GLOOMBERB_API_URL=http://localhost:3355

# Signalbase analytics terminal. The Google token needs analytics.readonly.
# Legacy single-site variables:
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_ACCESS_TOKEN=
